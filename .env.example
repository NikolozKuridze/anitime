POSTGRES_PASSWORD=change-me
REDIS_PASSWORD=change-me
JWT_SIGNING_KEY=change-me
RABBITMQ_PASSWORD=change-me
MINIO_ROOT_PASSWORD=change-me
# JWT_SIGNING_KEY must be at least 32 characters.

