POSTGRES_PASSWORD=change-me
REDIS_PASSWORD=change-me
JWT_SIGNING_KEY=change-me
RABBITMQ_PASSWORD=change-me
MINIO_ROOT_PASSWORD=change-me
# JWT_SIGNING_KEY must be at least 32 characters.

# Password reset emails (optional). Without these the API still answers but sends nothing.
# EMAIL_FROM must use a domain verified in Resend.
EMAIL_PROVIDER=Resend
RESEND_API_KEY=
EMAIL_FROM=ANITIME <no-reply@anitime.space>

# Force-update gate, served by GET /api/app/config. Builds below these must update; 0 / 0.0.0 blocks nothing.
MIN_IOS_BUILD=0
MIN_APP_VERSION=0.0.0
